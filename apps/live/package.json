{
  "name": "@stowage/live",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Native adaptive-bitrate live streaming: MediaMTX ingest → FFmpeg ladder → HLS",
  "scripts": {
    "fetch-bins": "sh scripts/fetch-bins.sh",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "hls.js": "^1.6.13",
    "hono": "^4.10.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  }
}
