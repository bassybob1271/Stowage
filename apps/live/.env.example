# Copy to .env (gitignored).
LIVE_PUBLISH_USER=publisher
LIVE_PUBLISH_PASS=
LIVE_PUBLIC_URL=https://live.example.com
LIVE_TITLE=Live
# BazzyBox storage site, linked from the page header (empty hides it).
LIVE_BOX_URL=https://box.bazzy.tv
# LIVE_LADDER=1080,720,480,360
# LIVE_INGEST_HOST=127.0.0.1
# Bazzy TV, linked from the header (empty hides it).
LIVE_TV_URL=https://video.bazzy.tv

# ── Sign in with Bazzy TV: creators get their own channel + stream key at /studio ──
# Register in Bazzy TV's OAUTH_CLIENTS: client_id bazzylive, redirect https://live.bazzy.tv/auth/bazzy/callback
# LIVE_BAZZY_AUTH_URL=https://video.bazzy.tv
LIVE_BAZZY_CLIENT_ID=bazzylive
LIVE_BAZZY_CLIENT_SECRET=
# openssl rand -hex 32
LIVE_SESSION_SECRET=
# Bazzy TV roles allowed to go live (* = anyone)
LIVE_CREATOR_ROLES=filmmaker,admin
# OBS "Server" shown in Studio, e.g. rtmp://<this Mac's LAN address>:1935/live
# LIVE_RTMP_PUBLIC_URL=

# ── Recordings → Backblaze B2 bucket BazzyLive (a key limited to that bucket) ──
LIVE_RECORD=true
# LIVE_B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# LIVE_B2_BUCKET=bazzylive
# LIVE_B2_KEY_ID=
# LIVE_B2_APP_KEY=
# LIVE_RECORD_SEGMENT=1h
