# ---- Stowage configuration (copy to deploy/.env and edit) ----

# Access gate. "42" is a DEMO code, not security. Change it, and use TLS, before exposing the app.
ACCESS_CODE=42

# Required. Generate each with:  openssl rand -hex 32
SESSION_SECRET=
MASTER_KEY=

# Session lifetime (rolling), days.
SESSION_TTL_DAYS=7
# Cookies are Secure by default. docker-compose sets false for the plain-http quickstart;
# set true when serving over HTTPS (e.g. the "tls" profile).
COOKIE_SECURE=true
# Only behind your own reverse proxy: trust X-Forwarded-For for rate limiting.
TRUST_PROXY=false

# Metadata DB. SQLite (default) or Postgres:
#   DATABASE_URL=postgres://stowage:pass@postgres:5432/stowage
DATABASE_URL=file:/data/stowage.db

# true = browsers fetch files directly from S3 via presigned URLs (needs a browser-reachable
# endpoint; set publicEndpoint on the mount). false = proxy all bytes through the server.
DIRECT_TRANSFER=false

# Optional separate origin for serving user content, e.g. https://content.example.com
# (point it at the same server). Strongest isolation for uploaded HTML/SVG.
CONTENT_ORIGIN=
APP_ORIGIN=

# 0 = unlimited (uploads are chunked/resumable).
MAX_UPLOAD_BYTES=0
# Background index reconcile interval in seconds (0 = off).
RECONCILE_INTERVAL_SEC=900
LOG_LEVEL=info

# ---- BazzyBox: accounts, plans, credits (see docs/BAZZYBOX.md) ----
# true = email/password sign-up, a private folder per user, the Flex plan and a credits wallet.
BAZZYBOX=false
# Mount in mounts.yaml that holds every user's files (under u/<id>/). Point it at Backblaze B2.
BOX_MOUNT=box
BOX_FREE_GB=10
# open | closed
BOX_SIGNUP=open
# "Sign in with Bazzy TV": the Bazzy TV website handles the login (email, Apple, Google).
# Register BazzyBox in Bazzy TV's OAUTH_CLIENTS with redirect URI https://box.bazzy.tv/api/auth/bazzy/callback
# and the same secret. Needs APP_ORIGIN set to BazzyBox's public address.
# BAZZY_AUTH_URL=https://bazzyvideo.com
BAZZY_CLIENT_ID=bazzybox
BAZZY_CLIENT_SECRET=
# The other Bazzy sites, linked from the BazzyBox website and app (empty hides a link).
BAZZY_TV_URL=https://video.bazzy.tv
BAZZY_LIVE_URL=https://live.bazzy.tv
# Behind the Cloudflare tunnel, set APP_ORIGIN above to https://box.bazzy.tv (CSRF origin check).
# Stripe (credit top-ups). Webhook endpoint: https://<your host>/api/box/webhook/stripe,
# event checkout.session.completed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Local testing only: grant credits without payment. Refused when NODE_ENV=production.
BOX_DEV_CREDITS=false
# Storage meter + plan renewals, seconds.
BOX_METER_INTERVAL_SEC=3600
# Backblaze B2 bucket for BazzyBox (B2 console → Buckets: endpoint; App Keys: a key for this bucket only).
# Keep it private (not public) and separate from Bazzy TV's and Bazzy Live's buckets.
# BOX_B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# BOX_B2_REGION=us-east-005
# BOX_B2_BUCKET=bazzybox
# BOX_B2_KEY_ID=
# BOX_B2_APP_KEY=
# Backup copy (not on B2): nightly rclone sync of this bucket to IDrive e2 or a Hetzner Storage Box.

# ---- Per-mount sample variables (referenced from mounts.yaml as ${VAR}) ----
# Bundled S3 dev target (the "minio" service).
S3_ACCESS_KEY=stowage
S3_SECRET_KEY=change-me-s3-secret

# Hosted S3 examples
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# B2_BUCKET=
# B2_KEY_ID=
# B2_APP_KEY=

# IPFS remote pinning (IPFS Pinning Service API, e.g. Pinata / Filebase / 4EVERLAND)
# PINNING_ENDPOINT=https://api.pinata.cloud/psa
# PINNING_TOKEN=

# Optional services
# Cloudflare Tunnel (--profile tunnel; config in deploy/cloudflared/, see README).
# With a tunnel, also set COOKIE_SECURE=true, TRUST_PROXY=true,
# APP_ORIGIN=https://<your hostname>, and change ACCESS_CODE.
# RCLONE_REMOTE=gdrive:
# DOMAIN=files.example.com
# APP_BIND=0.0.0.0
