{
  "name": "stowage",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @stowage/server --filter @stowage/web dev",
    "dev:infra": "docker compose -f deploy/docker-compose.test.yml up -d",
    "build": "pnpm -r --filter !@stowage/e2e build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --filter !@stowage/e2e test",
    "test:infra": "pnpm --filter @stowage/storage test:infra",
    "e2e": "pnpm --filter @stowage/web build && pnpm --filter @stowage/e2e e2e",
    "up": "docker compose -f deploy/docker-compose.yml up -d --build"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.19.0"
  },
  "packageManager": "pnpm@12.21.0"
}
